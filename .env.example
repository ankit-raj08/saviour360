# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/saviour360

# Payload
PAYLOAD_SECRET=saviour360-secret-change-this
PAYLOAD_PUBLIC_SERVER_URL=https://saviour360-production.up.railway.app

# Frontend (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# Cloudinary — get these from https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

PORT=3001
