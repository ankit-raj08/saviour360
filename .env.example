# ─────────────────────────────────────────────────────────────────────────────
# Saviour360 — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, set these in your Vercel project dashboard under:
#   Settings → Environment Variables
#
# ─────────────────────────────────────────────────────────────────────────────

# Payload CMS base URL (no trailing slash)
# ● Local dev:   leave empty — all sections fall back to hardcoded data silently
# ● Production:  set to your Railway deployment URL, e.g. https://saviour360-cms.railway.app
VITE_CMS_URL=
